#PBS -S /bin/bash
#PBS -q auto_free
#PBS -j oe
#PBS -N airimu_finetune
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=36:mem=250gb:ngpus=1

set -e

cd $PBS_O_WORKDIR

module load apptainer/1.4.1

image=/app1/common/singularity-img/vanda/pytorch_2.5_cuda_12.4_unsloth.sif

echo "Working directory:"
pwd

echo "Compute node:"
hostname

echo "GPU:"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv

echo "Starting AirIMU Stage 1 (covaug=False)"

apptainer exec --nv -e $image \
python3 -u train_motion_finetune.py \
--config configs/exp/TLab/finetune_motion_body.conf \
--device cuda:0

echo "Stage 1 finished. Starting Stage 2 (covaug=True)"

apptainer exec --nv -e $image \
python3 -u train_motion_finetune.py \
--config configs/exp/TLab/finetune_motion_body_stage2.conf \
--device cuda:0

echo "Stage 2 finished. Running inference and evaluation"

apptainer exec -e $image \
python3 -u inference.py \
--config configs/exp/TLab/finetune_motion_body_stage2.conf \
--device cuda:0

apptainer exec -e $image \
python3 -u evaluation/evaluate_state.py \
--dataconf configs/datasets/TLab/tlab_body.conf \
--exp experiments/tlab_stage2/finetune_motion_body_stage2/

echo "Inference and evaluation finished. Exporting the best model to ONNX"

apptainer exec -e $image \
python3 -u export_onnx_fp32.py \
--config configs/exp/TLab/finetune_motion_body_stage2.conf \
--device cuda:0 \
--ckpt experiments/tlab_stage2_4th_Nov/finetune_motion_body_stage2/ckpt/0029.ckpt \
--onnx experiments/tlab_stage2_4th_Nov/finetune_motion_body_stage2/airimu_cpu_fp32_finetuned.onnx \
--torch experiments/tlab_stage2_4th_Nov/finetune_motion_body_stage2/airimu_cpu_fp32.pt \
--num-imu-frames 200

echo "AirIMU finetuning and ONNX export finished"
