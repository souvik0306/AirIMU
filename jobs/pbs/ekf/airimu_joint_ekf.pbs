#PBS -S /bin/bash
#PBS -q auto_free
#PBS -j oe
#PBS -o jobs/logs/ekf/
#PBS -e jobs/logs/ekf/
#PBS -N airimu_joint_ekf
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=36:mem=250gb:ngpus=1

# Submit with:
#   qsub jobs/pbs/ekf/airimu_joint_ekf.pbs
# Override inputs or runtime settings with:
#   qsub -v EKF_DATASET_CONFIG=/absolute/path/tlab_body.conf,EKF_EPOCHS=30 jobs/pbs/ekf/airimu_joint_ekf.pbs
# AIRIMU_MAX_EPOCHES is optional; when unset, Stage 1 and Stage 2 use their
# full configured epoch counts. It is intended only for short flow checks.

set -euo pipefail

cd "$PBS_O_WORKDIR"
module load apptainer/1.4.1

image=/app1/common/singularity-img/vanda/pytorch_2.5_cuda_12.4_unsloth.sif
stage1_config=${STAGE1_CONFIG:-configs/exp/TLab/4th_Nov_Scratch.conf}
stage2_config=${STAGE2_CONFIG:-configs/exp/TLab/4th_Nov_Scratch_stage2.conf}
dataset_config=${EKF_DATASET_CONFIG:-configs/datasets/TLab/tlab_body.conf}
sensor_metadata_root=${SENSOR_METADATA_ROOT:-initial_sensor_biases}
ekf_epochs=${EKF_EPOCHS:-30}
ekf_learning_rate=${EKF_LR:-1e-5}
training_options=(--configuration "${EKF_CONFIGURATION:-B}"
                  --gyro-weight "${EKF_GYRO_WEIGHT:-1e-4}"
                  --smoothness-weight "${EKF_SMOOTHNESS_WEIGHT:-0}"
                  --gru2-lr "${EKF_GRU2_LR:-1e-6}"
                  --gru1-lr "${EKF_GRU1_LR:-5e-7}")
if [[ "${EKF_CONFIGURATION:-B}" == "C" ]]; then
    training_options+=(--configuration-c-evidence "${EKF_A_RUN:?Set EKF_A_RUN}" "${EKF_B_RUN:?Set EKF_B_RUN}")
fi
cpu_threads=${EKF_CPU_THREADS:-1}
replay_workers=${EKF_REPLAY_WORKERS:-4}
flight_batch_size=${EKF_FLIGHT_BATCH_SIZE:-$((replay_workers > 0 ? replay_workers : 1))}
feature_cache_mb=${EKF_FEATURE_CACHE_MB:-512}
replay_backend=${EKF_REPLAY_BACKEND:-compiled}
default_ekf_device=cpu
if [[ "$replay_workers" == "0" ]]; then default_ekf_device=cuda:0; fi
ekf_device=${EKF_DEVICE:-$default_ekf_device}
run_fixed_baseline=${EKF_FIXED_BASELINE:-1}

airimu_epoch_args=()
if [[ -n "${AIRIMU_MAX_EPOCHES:-}" ]]; then
    airimu_epoch_args=(--max_epoches "$AIRIMU_MAX_EPOCHES")
fi

for required_file in "$stage1_config" "$stage2_config" "$dataset_config"; do
    if [[ ! -f "$required_file" ]]; then
        echo "ERROR: required file not found: $required_file" >&2
        exit 2
    fi
done
if [[ ! -d "$sensor_metadata_root" ]]; then
    echo "ERROR: sensor metadata directory not found: $sensor_metadata_root" >&2
    exit 2
fi

run_timestamp=$(TZ=Asia/Singapore date +%Y%m%d_%H%M%S_SGT)
job_id=${PBS_JOBID%%.*}
run_root=${EKF_RUN_ROOT:-experiments/${run_timestamp}_job${job_id}/joint_ekf}
experiment_run_dir=${EKF_EXPERIMENT_DIR:-$run_root}
if [[ -z "${EKF_EXPERIMENT_DIR:-}" && "$(basename "$run_root")" == "joint_ekf" ]]; then
    experiment_run_dir=$(dirname "$run_root")
fi
stage1_output="$run_root/airimu_stage1"
stage2_output="$run_root/airimu_stage2"
ekf_training_output="$run_root/ekf_training"
inference_output="$experiment_run_dir/inference_ekf"
state_evaluation="$experiment_run_dir/evaluation_results_ekf"
learned_evaluation="$state_evaluation/eskf_test"
fixed_evaluation="$run_root/evaluation_fixed"

echo "AirIMU and joint differentiable ESKF workflow"
echo "Run root: $run_root"
echo "Best EKF model inference: $inference_output"
echo "Best EKF model evaluation: $state_evaluation"
echo "Dataset config: $dataset_config"
echo "Sensor metadata: $sensor_metadata_root"
echo "ESKF epochs: $ekf_epochs; ESKF learning rate: $ekf_learning_rate"
echo "ESKF device: $ekf_device (AirIMU network: cuda:0)"
echo "Replay workers: $replay_workers; threads/worker: 1; flights/Adam step: $flight_batch_size"
echo "Replay backend: $replay_backend"
echo "Working directory: $(pwd)"
echo "Compute node: $(hostname)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv

if [[ -n "${AIRIMU_CKPT:-}" ]]; then
    stage2_checkpoint=$AIRIMU_CKPT
    echo "Using existing Stage 2 checkpoint: $stage2_checkpoint"
else
    echo "Starting AirIMU Stage 1 from random initialization."
    apptainer exec --nv -e "$image" \
    python3 -u train_motion_finetune.py \
    --config "$stage1_config" \
    --exp_dir "$stage1_output" \
    --pretrained_ckpt none \
    --device cuda:0 \
    "${airimu_epoch_args[@]}"

    stage1_checkpoint="$stage1_output/ckpt/best_model.ckpt"
    if [[ ! -f "$stage1_checkpoint" ]]; then
        echo "ERROR: AirIMU Stage 1 completed without best_model.ckpt" >&2
        exit 3
    fi

    echo "Starting AirIMU Stage 2 from this job's new Stage 1 checkpoint."
    apptainer exec --nv -e "$image" \
    python3 -u train_motion_finetune.py \
    --config "$stage2_config" \
    --exp_dir "$stage2_output" \
    --pretrained_ckpt "$stage1_checkpoint" \
    --non_strict_pretrained \
    --device cuda:0 \
    "${airimu_epoch_args[@]}"

    stage2_checkpoint="$stage2_output/ckpt/best_model.ckpt"
fi
if [[ ! -f "$stage2_checkpoint" ]]; then
    echo "ERROR: Stage 2 checkpoint not found: $stage2_checkpoint" >&2
    exit 4
fi

echo "Starting joint ESKF training from the Stage 2 checkpoint: $stage2_checkpoint"
inductor_cache="${TMPDIR:-/tmp}/airimu_inductor_${job_id}"
apptainer exec --nv -e --env PYTHONNOUSERSITE=1 \
--env "TORCHINDUCTOR_CACHE_DIR=$inductor_cache" \
--env TORCHINDUCTOR_FX_GRAPH_CACHE=1,TORCHINDUCTOR_COMPILE_THREADS=1 \
--env OMP_NUM_THREADS=1,MKL_NUM_THREADS=1,OPENBLAS_NUM_THREADS=1 "$image" \
python3 -s -u jobs/utils/container_python.py train_eskf.py \
--config "$stage2_config" \
--ckpt "$stage2_checkpoint" \
--dataset-config "$dataset_config" \
--sensor-metadata-root "$sensor_metadata_root" \
--output "$ekf_training_output" \
--device cuda:0 \
--ekf-device "$ekf_device" \
--epochs "$ekf_epochs" \
--lr "$ekf_learning_rate" \
--cpu-threads "$cpu_threads" \
--replay-workers "$replay_workers" \
--replay-backend "$replay_backend" \
--flight-batch-size "$flight_batch_size" \
--feature-cache-mb "$feature_cache_mb" \
"${training_options[@]}"

if [[ ! -f "$ekf_training_output/best_model.ckpt" ]]; then
    echo "ERROR: ESKF training completed without best_model.ckpt" >&2
    exit 5
fi

ekf_best_checkpoint=$(realpath "$ekf_training_output/best_model.ckpt")
mkdir -p "$inference_output" "$state_evaluation"

echo "Training finished. Running inference with the best EKF checkpoint: $ekf_best_checkpoint"
apptainer exec --nv -e "$image" \
python3 -u inference.py \
--config "$stage2_config" \
--load "$ekf_best_checkpoint" \
--exp_dir "$inference_output" \
--device cuda:0

if [[ ! -s "$inference_output/net_output.pickle" ]]; then
    echo "ERROR: EKF model inference completed without net_output.pickle" >&2
    exit 6
fi

echo "Evaluating best EKF model inference: $state_evaluation"
apptainer exec -e "$image" \
python3 -u evaluation/evaluate_state.py \
--device cpu \
--dataconf "$dataset_config" \
--exp "$inference_output" \
--savedir "$state_evaluation"

echo "Evaluating the best EKF checkpoint on the test split: $learned_evaluation"
apptainer exec --nv -e "$image" \
python3 -u -m evaluation.evaluate_eskf \
--config "$stage2_config" \
--ckpt "$ekf_best_checkpoint" \
--dataset-config "$dataset_config" \
--sensor-metadata-root "$sensor_metadata_root" \
--output "$learned_evaluation" \
--split test \
--device cuda:0 \
--ekf-device "$ekf_device" \
--cpu-threads "$cpu_threads"

if [[ "$run_fixed_baseline" == "1" ]]; then
    echo "Evaluating the fixed-noise EKF baseline on the same test split."
    apptainer exec --nv -e "$image" \
    python3 -u -m evaluation.evaluate_eskf \
    --dataset-config "$dataset_config" \
    --sensor-metadata-root "$sensor_metadata_root" \
    --output "$fixed_evaluation" \
    --split test \
    --device cuda:0 \
    --ekf-device "$ekf_device" \
    --cpu-threads "$cpu_threads"
fi

echo "AirIMU, joint ESKF training, and evaluation finished: $run_root"
