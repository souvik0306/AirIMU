#PBS -S /bin/bash
#PBS -q auto_free
#PBS -j oe
#PBS -N airimu_ekf_bench
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1

# Two complete EKF epochs; uses an existing Stage 2 checkpoint.
# qsub airimu_ekf_benchmark.pbs
# CUDA regression checks only (no training):
# qsub -l select=1:ncpus=2:mem=16gb:ngpus=1 -l walltime=00:10:00 -v EKF_CHECK_ONLY=1 airimu_ekf_benchmark.pbs
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load apptainer/1.4.1
image=/app1/common/singularity-img/vanda/pytorch_2.5_cuda_12.4_unsloth.sif
checkpoint=${AIRIMU_CKPT:-experiments/20261116_151808_SGT_bias_no_cov_limits/scratch/stage2/ckpt/best_model.ckpt}
config=${EKF_CONFIG:-configs/exp/TLab/ekf_no_cov_limits.conf}
dataset=${EKF_DATASET_CONFIG:-configs/datasets/TLab/tlab_body.conf}
metadata=${SENSOR_METADATA_ROOT:-initial_sensor_biases}
run_timestamp=$(TZ=Asia/Singapore date +%Y%m%d_%H%M%S_SGT)
run_root=${EKF_RUN_ROOT:-experiments/${run_timestamp}_job${PBS_JOBID%%.*}_ekf_benchmark}
mkdir -p "$run_root"
exec > >(tee "$run_root/job.log") 2>&1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export TORCHINDUCTOR_CACHE_DIR="${TMPDIR:-/tmp}/airimu_inductor_${PBS_JOBID%%.*}"
export TORCHINDUCTOR_FX_GRAPH_CACHE=1 TORCHINDUCTOR_COMPILE_THREADS=1
export MPLBACKEND=Agg
printf 'Run directory: %s\nNode: %s\n' "$run_root" "$(hostname)"
printf 'Stage 2 checkpoint: %s\nNetwork config: %s\n' "$checkpoint" "$config"
printf 'Height fusion: clean Vicon Z before and after cutoff, one update per estimate, std=0.1 m.\n'
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv
# Keep a record of allocated GPU activity throughout compilation and training.
nvidia-smi --query-gpu=timestamp,name,utilization.gpu,utilization.memory,memory.used,power.draw \
    --format=csv -l 10 > "$run_root/gpu_usage.csv" &
monitor_pid=$!
trap 'kill "$monitor_pid" 2>/dev/null || true' EXIT
run_python() {
    apptainer exec --nv -e --env PYTHONNOUSERSITE=1 \
        --env OMP_NUM_THREADS=1,MKL_NUM_THREADS=1,OPENBLAS_NUM_THREADS=1 \
        --env "TORCHINDUCTOR_CACHE_DIR=$TORCHINDUCTOR_CACHE_DIR" \
        --env TORCHINDUCTOR_FX_GRAPH_CACHE=1,TORCHINDUCTOR_COMPILE_THREADS=1,MPLBACKEND=Agg \
        "$image" python3 -s scripts/container_python.py "$@"
}
printf 'Checking CPU/CUDA replay gradients and validation before benchmarking.\n'
# A GPU allocation must exercise the CUDA regression instead of skipping it.
apptainer exec --nv -e "$image" python3 -s -c \
    'import torch; assert torch.cuda.is_available(), "CUDA is required for this job"; print("CUDA checks on:", torch.cuda.get_device_name(0), flush=True)'
run_python tests/test_compiled_eskf.py
run_python tests/test_height_eskf.py
if [[ "${EKF_CHECK_ONLY:-0}" == 1 ]]; then
    printf 'CPU/CUDA replay gradient and validation checks passed.\n'
    exit 0
fi
printf 'Measuring replay performance and checking the selected Stage 2 model.\n'
run_python benchmarks/benchmark_eskf.py --config "$config" --ckpt "$checkpoint" \
    --dataset-config "$dataset" --sensor-metadata-root "$metadata" --output "$run_root"
runtime="$run_root/runtime.json"
workers=$(python3 -s -c 'import json,sys; print(json.load(open(sys.argv[1]))["replay_workers"])' "$runtime")
batch_size=$(python3 -s -c 'import json,sys; print(json.load(open(sys.argv[1]))["flight_batch_size"])' "$runtime")
ekf_device=$(python3 -s -c 'import json,sys; print(json.load(open(sys.argv[1]))["ekf_device"])' "$runtime")
printf 'Starting two complete training epochs.\n'
run_python train_eskf.py --config "$config" --ckpt "$checkpoint" \
    --dataset-config "$dataset" --sensor-metadata-root "$metadata" \
    --output "$run_root/training" --device cuda:0 --ekf-device "$ekf_device" \
    --replay-backend compiled --replay-workers "$workers" --flight-batch-size "$batch_size" \
    --cpu-threads 1 --feature-cache-mb 512 --height-updates --epochs 2 --lr 1e-5
printf 'Two-epoch benchmark complete: %s\n' "$run_root"
